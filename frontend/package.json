{
  "name": "web-app",
  "type": "module",
  "version": "1.5.0",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=26.9.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "postbuild": "node scripts/stage-swa-config.mjs && node scripts/check-image-hosts.mjs",
    "build:data": "node scripts/generate-public-data.cjs",
    "data:update:applied-skills": "node scripts/update-applied-skills.mjs",
    "data:update:credentials": "node scripts/update-applied-skills.mjs",
    "data:update:study-guides": "node scripts/update-study-guides.mjs",
    "art:generate": "node scripts/generate-brand-art.mjs",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,md}\"",
    "audit:pages": "node scripts/audit-published-pages.mjs",
    "validate:routes": "node scripts/validate-routes.js",
    "validate:providers": "node scripts/validate-provider-pages.js",
    "validate:content-matrix": "node scripts/validate-content-matrix.cjs",
    "code:quality": "npm run lint && npm run format:check && npm run validate:routes && npm run validate:providers && npm run validate:content-matrix",
    "code:fix": "npm run lint:fix && npm run format",
    "a11y:contrast": "node scripts/axe-theme-scan.mjs",
    "a11y:contrast:report": "node scripts/axe-report-summary.mjs",
    "a11y:contrast:e2e": "playwright test contrast.spec.js",
    "a11y:audit": "npm run a11y:contrast",
    "clean": "node -e \"const fs=require('fs');const rm=p=>{try{fs.rmSync(p,{recursive:true,force:true})}catch{}};rm('dist');rm('node_modules/.vite');\"",
    "clean:all": "node -e \"const fs=require('fs');const rm=p=>{try{fs.rmSync(p,{recursive:true,force:true})}catch{}};rm('dist');rm('node_modules');\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --testTimeout=30000 --hookTimeout=60000",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "verify:required": "npm run build && npm run test",
    "verify:optional:release": "npm run test:e2e"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.25.1",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@tailwindcss/postcss": "^4.3.0",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "framer-motion": "^14.3.0",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.90.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "react-syntax-highlighter": "^16.1.2",
    "react-zoom-pan-pinch": "^4.2.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.1",
    "baseline-browser-mapping": "^2.11.29",
    "dotenv": "^18.0.8",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "pdf-parse": "^2.4.5",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@napi-rs/canvas": "^1.0.9",
    "@hono/node-server": "2.0.10",
    "@opentelemetry/core": "2.8.0",
    "brace-expansion": "5.0.12",
    "uuid": "^11.0.0",
    "node-domexception": "^2.0.2",
    "debug": "^4.3.7",
    "highlight.js": "^11.9.0",
    "prismjs": "^1.30.0",
    "minimatch": "^10.2.2",
    "glob": "^13.0.6",
    "rimraf": "^6.1.3",
    "archiver": "^7.0.1",
    "readdir-glob": "^3.0.0",
    "ajv": "^8.18.0",
    "@eslint/eslintrc": {
      "ajv": "6.14.0"
    },
    "eslint": {
      "ajv": "6.14.0"
    },
    "hono": "^4.12.34",
    "nanoid": "^3.3.18",
    "js-yaml": "^4.3.1",
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint",
      "minimatch": "^3.1.2",
      "brace-expansion": "^1.1.21"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "postcss-selector-parser": "7.1.6"
  }
}
