        }
        "Deploy-Private-DNS-Zones" = {
          enforcement_mode = "DoNotEnforce"
        }
      }
    }
    local = {
      policy_assignments = {
        "Enforce-ALDO-Services" = {
          enforcement_mode = "DoNotEnforce"
        }
      }
    }
    sandbox = {
      policy_assignments = {
