          enforcement_mode = "DoNotEnforce"
        }
        "Deploy-MDEndpoints" = {
          enforcement_mode = "DoNotEnforce"
        }
        "Deploy-MDEndpointsAMA" = {
          enforcement_mode = "DoNotEnforce"
        }
        "Deploy-MDFC-Config-H224" = {
          enforcement_mode = "DoNotEnforce"
