          enforcement_mode = "DoNotEnforce"
        }
        "Deploy-SvcHealth-BuiltIn" = {
          enforcement_mode = "DoNotEnforce"
        }
        "Enforce-ACSB" = {
          enforcement_mode = "DoNotEnforce"
        }
