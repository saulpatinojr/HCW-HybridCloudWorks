'
AVM_CHILD_CALLS='
avm-ptn-alz-connectivity-hub-and-spoke-vnet@0.17.5 avm-ptn-network-private-link-private-dns-zones@0.23.2
avm-ptn-alz-connectivity-hub-and-spoke-vnet@0.17.5 avm-res-network-azurefirewall@0.4.0
