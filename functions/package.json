{
  "name": "hybridcloudworks-functions-azure",
  "description": "Azure Functions API and workers for the HybridCloudWorks website",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/functions/index.js",
  "scripts": {
    "start": "func start",
    "build": "echo 'No build step required'",
    "lint": "eslint src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --testTimeout=30000 --hookTimeout=60000",
    "deploy": "echo \"Use the deploy-functions workflow, or: func azure functionapp publish $(terraform -chdir=../infra output -raw function_app_name)\" && exit 1"
  },
  "engines": {
    "node": "^24.20.0"
  },
  "dependencies": {
    "@aws-sdk/client-pricing": "^3.1152.0",
    "@azure/cosmos": "^4.10.1",
    "@azure/functions": "^4.16.5",
    "@azure/identity": "^4.14.0",
    "@azure/storage-blob": "^12.34.0",
    "@breezystack/lamejs": "^1.2.7",
    "cheerio": "^1.2.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.0.1",
    "rss-parser": "^3.13.0",
    "sharp": "^0.35.5",
    "turndown": "^7.2.4",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "vitest": "^5.0.0"
  },
  "private": true,
  "overrides": {
    "@azure/msal-node": "7.1.1",
    "nanoid": "^3.3.18"
  }
}
