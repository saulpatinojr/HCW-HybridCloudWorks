# Labs VPS agent configuration.
#
# This file must never contain a database credential. The agent has no Cosmos
# client: it authenticates to the Functions API with an Entra certificate and
# can only reach four endpoints (functions/src/lib/lab-agent.js). If a future
# change here needs COSMOS_ANYTHING, that is the signal something has gone
# wrong. bin/report-coder-automation.js reads this same file's names, through
# lib/config.js, as index.js does.

# The Functions API base, including the `api` route prefix, as this host
# reaches it: the Cloudflare hostname. The Function App's origin lock denies
# every address outside Cloudflare's ranges, so its azurewebsites.net host
# answers an agent host 403. On the lab host scripts/lab/Register-LabAgent.ps1
# writes this, and the three below, into the Ansible vault.
LABS_AGENT_API_BASE=https://api-azure.hybridcloudworks.com/api

# Entra app registration for THIS agent — confidential client, assigned the
# `LabAgent` App Role on the API. One registration per agent host, so a
# compromised VPS is revoked on its own rather than for the whole fleet.
LABS_AGENT_TENANT_ID=REPLACE_ME_WITH_TENANT_ID
LABS_AGENT_CLIENT_ID=REPLACE_ME_WITH_AGENT_CLIENT_ID

# PEM file holding the certificate and its private key. Generated ON this host
# (lab-host/ansible, role labs_agent); only the public certificate leaves it,
# to be uploaded to the app registration — the private key never travels.
# Owner root, group hcw-labs-agent, mode 0640, no ACLs: root owns it, the
# service user reads it through its group, nobody else can. Outside the
# repository.
LABS_AGENT_CERT_PATH=/etc/hcw/labs-agent.pem

# Scope requested for the API token. Its audience must match the Functions
# app's ENTRA_API_AUDIENCE, or every call returns 401.
LABS_AGENT_API_SCOPE=api://REPLACE_ME_WITH_API_CLIENT_ID/.default

# Must match the id of this agent's `lab_agents` registry document. The server
# refuses the call if the document's `oid` is not this credential's object id,
# so a wrong value here fails closed rather than acting as another agent.
LABS_AGENT_ID=vps-hostinger-01

# Job execution limits, applied per container by lib/docker-runner.js.
LABS_AGENT_MAX_CONCURRENT=1
LABS_AGENT_POLL_MS=15000
LABS_AGENT_JOB_MEMORY=512m
LABS_AGENT_JOB_CPUS=0.5
LABS_AGENT_JOB_PIDS=128
LABS_AGENT_JOB_NOFILE=1024

# On SIGTERM the agent interrupts every running job, removes its container
# and reports it as interrupted, and waits this many milliseconds for those
# reports before it goes offline and exits (lib/shutdown.js). A positive
# whole number; anything else is 5000. The unit's TimeoutStopSec must cover
# it plus the two 5 s shutdown heartbeats (labs_agent_timeout_stop_sec).
LABS_AGENT_SHUTDOWN_TIMEOUT_MS=5000

# NOTE: capabilities are NOT configured here. The job types this agent may
# claim come from the `capabilities` array on its lab_agents registry document,
# which only an admin can change. An agent that names its own capabilities can
# claim any job type, which would make the server-side allowlist decorative.
