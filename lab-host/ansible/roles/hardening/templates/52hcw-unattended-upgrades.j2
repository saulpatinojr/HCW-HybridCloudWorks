// {{ ansible_managed }}
// Overrides for /etc/apt/apt.conf.d/50unattended-upgrades. The allowed
// origins are rendered here from hardening_unattended_allowed_origins rather
// than inherited from that file's defaults (LAB-13, #959), so what may move
// is written down where tests/unattended-upgrades.test.sh reads it. The
// third-party repositories the docker and labs_agent roles add are pinned
// and held, so nothing here can move them. hcw-held-upgradable.timer says,
// daily, when apt has something newer for one of them (LAB-3, #949).
#clear Unattended-Upgrade::Allowed-Origins;
Unattended-Upgrade::Allowed-Origins {
{% for origin in hardening_unattended_allowed_origins %}
  "{{ origin }}";
{% endfor %}
};
// The upgrade runs here; the reboot does not (LAB-13, #959). With this on,
// unattended-upgrade asked `users` when the upgrade ran, about twenty-two
// hours before the hour, then scheduled `shutdown -r` for that hour with no
// further question, and it never asked whether a visitor's job container was
// running. hcw-reboot-when-idle.timer reboots instead, at
// {{ hardening_unattended_reboot_time }}, asking both at the hour itself.
// Automatic-Reboot-WithUsers and Automatic-Reboot-Time are read only while
// this is true, so neither is set.
Unattended-Upgrade::Automatic-Reboot "false";
Unattended-Upgrade::Remove-Unused-Dependencies "true";
Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";
