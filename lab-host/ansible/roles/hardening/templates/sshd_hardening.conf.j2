# {{ ansible_managed }}
# Named 00- on purpose. sshd keeps the FIRST value it reads for a keyword and
# includes sshd_config.d/*.conf in lexical order, so this file must sort before
# the cloud image's 50-cloud-init.conf, which sets PasswordAuthentication yes.
# AllowUsers is the exception: every AllowUsers line adds to the list, so no
# other file may set one. The hardening role reads the result back with
# sshd -T before it reloads sshd (#953).

# Who, and how: one account, by key, from the one file the role writes.
AllowUsers {{ hardening_sshd_allow_users | join(' ') }}
AuthenticationMethods publickey
PubkeyAuthentication yes
AuthorizedKeysFile .ssh/authorized_keys
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
MaxAuthTries 4

# What a session may do. Local forwards stay: VS Code Remote-SSH and the
# Portainer tunnel (ssh -L) use them. No remote forwards, no agent
# forwarding, no tunnel devices, no X11.
AllowAgentForwarding no
AllowTcpForwarding local
PermitTunnel no
X11Forwarding no

# VERBOSE logs the fingerprint of the key each login used.
LogLevel VERBOSE
