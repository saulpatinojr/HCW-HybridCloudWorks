# {{ ansible_managed }}
# Named 00- on purpose. sshd keeps the FIRST value it reads for a keyword and
# includes sshd_config.d/*.conf in lexical order, so this file must sort before
# the cloud image's 50-cloud-init.conf, which sets PasswordAuthentication yes.
# AllowUsers is the exception: every AllowUsers line adds to the list, so no
# other file may set one. The hardening role reads the result back with
# sshd -T before it reloads sshd (#953).

# Who, and how: one account, by key, from the one file the role writes.
AllowUsers {{ hardening_sshd_allow_users | join(' ') }}
AuthenticationMethods publickey
PubkeyAuthentication yes
AuthorizedKeysFile .ssh/authorized_keys
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
MaxAuthTries 4
LoginGraceTime 30

# What a session may do. Local TCP forwards stay: VS Code Remote-SSH and the
# Portainer tunnel (ssh -L) use them. No remote forwards, no Unix-socket
# forwards, no agent forwarding, no tunnel devices, no X11.
AllowAgentForwarding no
AllowTcpForwarding local
AllowStreamLocalForwarding no
PermitTunnel no
X11Forwarding no

# Arc SSH sessions reach sshd from the loopback, so every one of them shares
# one source address; OpenSSH's per-source penalties would otherwise hold a
# few failed attempts there against every later Arc session.
PerSourcePenaltyExemptList 127.0.0.1,::1

{% if hardening_sshd_loopback_only | bool %}
# Bind sshd to the loopback alone (#1257). Ubuntu's sshd-socket-generator derives
# ssh.socket's ListenStream= lines from these at daemon-reload. Arc SSH arrives on
# the loopback, and hPanel's Web Console is a getty, so neither needs a public listener.
ListenAddress 127.0.0.1
ListenAddress ::1
{% else %}
# sshd listens on every address on this run: Azure Arc SSH is not ready to
# replace port 22 (tasks/arc_gate.yml), as on a rebuilt host before it is
# onboarded to Arc again. The first run with Arc SSH ready binds it to the
# loopback (#1257).
{% endif %}

# INFO already logs the fingerprint of the key each accepted login used
# (`Accepted publickey for ...`); VERBOSE adds the fingerprints of keys that
# were offered and refused. The login alert reads the `Accepted publickey`
# line and ignores VERBOSE's `Accepted key` and `Accepted certificate` lines.
LogLevel VERBOSE
