#!/usr/bin/env bash
# {{ ansible_managed }}
#
# Reboot for a pending upgrade, but only while the host is idle (LAB-13,
# #959). unattended-upgrades used to reboot: it asked `users` when the
# upgrade ran, in the morning's apt-daily-upgrade run, then scheduled
# `shutdown -r` for the reboot hour, some twenty-two hours later, with no
# further question, and it never asked whether a visitor's job container was
# running. A lab job killed at 04:30 is the evidence paragraph of #959. So
# the override turns Automatic-Reboot off and hcw-reboot-when-idle.timer
# runs this at the role's reboot hour instead; both questions are asked at
# the hour itself, and asked twice (below).
#
# In order, one syslog line per outcome, under the tag {{ hardening_reboot_when_idle_tag }}
# (journalctl -t {{ hardening_reboot_when_idle_tag }}):
#
#   apt has Automatic-Reboot on      warning  standing down; unattended-upgrades reboots, not this
#   no marker                        notice   nothing pending; stays on the host
#   a user is logged in              warning  deferred; tomorrow's run asks again
#   a job container is up            warning  deferred; tomorrow's run asks again
#   a Coder workspace is up          warning  deferred; tomorrow's run asks again
#   (idle: new lab jobs are held, and the script waits for the lab agent to
#   acknowledge the hold, then asks all three again)
#   no acknowledgement in time       warning  deferred; tomorrow's run asks again
#   any of the three at that look    warning  deferred; tomorrow's run asks again
#   apt-config, loginctl or a docker
#   daemon cannot say, or no hold or
#   pending record written           err      the run fails and the notifier (LAB-2) pages
#   idle at both looks               warning  rebooting, with how long it has waited
#
# A deferral of a reboot pending {{ hardening_reboot_overdue_days }} days or more is at err instead of
# warning, so a fix that has waited a week stands out from the nightly
# lines; the script still never reboots over a person, a job or a
# workspace. How long it has been pending is counted from the first time a
# run saw the marker, not from the marker's own time, which every upgrade
# that wants a reboot rewrites (below).
#
# Warning and err ship to Log Analytics through the Arc data collection
# rule, so every reboot and every deferral leaves a row there, and the daily
# held report (LAB-3) says at 07:15 for how long a reboot has been waiting.
# A check that cannot run has not run: an apt-config, a `loginctl` or a
# `docker` that fails, docker missing included, ends the run non-zero rather
# than guessing, and the unit's OnFailure= reports that.
set -euo pipefail

tag='{{ hardening_reboot_when_idle_tag }}'
reboot_required='{{ hardening_reboot_required_path }}'
job_label='{{ hardening_reboot_job_label }}'
workspace_docker_host='{{ hardening_reboot_workspace_docker_host }}'
workspace_label='{{ hardening_reboot_workspace_label }}'
hold='{{ hardening_reboot_hold_path }}'
ack='{{ hardening_reboot_ack_path }}'
agent_service='{{ hardening_reboot_agent_service }}'
hold_seconds='{{ hardening_reboot_hold_seconds }}'
settle_seconds='{{ hardening_reboot_hold_settle_seconds }}'
overdue_days='{{ hardening_reboot_overdue_days }}'
reboot_hour='{{ hardening_unattended_reboot_time }}'
systemctl='/usr/bin/systemctl'
{% raw %}
# say PRIORITY MESSAGE: one line under the tag, to the daemon facility at PRIORITY.
say() { logger -t "${tag}" -p "daemon.$1" -- "$2"; }

# One reboot authority at a time (CodeRabbit on #1191). A rollback to a
# revision before this script turns unattended-upgrades' own reboot back on
# and leaves this timer installed, and theirs asks nobody anything. So this
# stands down whenever apt's effective configuration has Automatic-Reboot on,
# which is that rollback's signature, and says so each night until the timer
# is withdrawn (docs/runbooks/labs-host.md, Runtime advisories). `/b` reads
# it the way unattended-upgrade does (FindB: true, yes, on and 1 are on);
# apt-config prints nothing for a key nobody set, which is off.
automatic_reboot="$(apt-config shell automatic_reboot Unattended-Upgrade::Automatic-Reboot/b)" || {
  say err "not rebooting: apt-config could not say whether unattended-upgrades reboots on its own, so the check has not run; its error is in this unit's journal and this run fails"
  exit 1
}
if [ "${automatic_reboot}" = "automatic_reboot='true'" ]; then
  say warning "standing down: unattended-upgrades' own Automatic-Reboot is on, so it reboots this host and this timer does not; withdraw the timer, or run bootstrap.sh from a revision that turns Automatic-Reboot off (docs/runbooks/labs-host.md, Runtime advisories)"
  exit 0
fi

# When this pending reboot was first seen (review of #1191). The marker's
# own time is no measure: every upgrade that wants a reboot rewrites it, so
# a reboot pending for a fortnight of kernel updates would read a day old
# and never reach the overdue line. The record keeps the marker's time as
# the first run that saw it found it, and is removed by the first run that
# finds no marker. It lives beside the hold, in the service's
# RuntimeDirectory= under /run, which is the marker's own lifetime: both are
# on the same tmpfs, so a reboot clears the two together and no record can
# outlive the reboot it was counting towards (a /var/lib record would, and
# would date the next boot's marker from the last boot's).
first_seen="${hold%/*}/reboot-pending-since"

if [ ! -e "${reboot_required}" ]; then
  rm -f -- "${first_seen}" "${first_seen}.new" || true
  say notice "no reboot is pending: ${reboot_required} does not exist"
  exit 0
fi

marker_epoch="$(stat -c %Y "${reboot_required}")"
since_epoch=''
[ ! -r "${first_seen}" ] || since_epoch="$(head -c 32 -- "${first_seen}" | tr -d '\n')"
case "${since_epoch}" in
  '' | *[!0-9]*) since_epoch='' ;;
esac
if [ -z "${since_epoch}" ] || [ "${marker_epoch}" -lt "${since_epoch}" ]; then
  since_epoch="${marker_epoch}"
  { printf '%s\n' "${since_epoch}" > "${first_seen}.new" && mv -f -- "${first_seen}.new" "${first_seen}"; } || {
    say err "not rebooting: the record of when this reboot was first seen could not be written, so how long it has waited cannot be told; its error is in this unit's journal and this run fails"
    exit 1
  }
fi
since="$(date -u -d "@${since_epoch}" +%Y-%m-%dT%H:%MZ)"
days=$(( ($(date -u +%s) - since_epoch) / 86400 ))

# defer REASON: say the reboot waits for REASON, at warning or, once it is overdue, at err; end the run successfully.
defer() {
  if [ "${days}" -ge "${overdue_days}" ]; then
    say err "deferred: $1; a reboot has been pending since ${since} (${days} days), overdue at ${overdue_days}: log out before ${reboot_hour}, or reboot at a time of your choosing (docs/runbooks/labs-host.md, Runtime advisories)"
  else
    say warning "deferred: $1; a reboot has been pending since ${since} (${days} days)"
  fi
  exit 0
}

# Who is logged in, from logind. `users` and `who` are not asked: on Ubuntu
# 26.04 they are rust-coreutils, which reads utmp, and systemd no longer
# writes utmp. Measured on the host on 2026-10-15, both printed nothing with
# an SSH session open, so unattended-upgrade's own WithUsers check, which
# read `users`, could never have seen anyone either.
#
# A person's login is a session of class `user`, or `user-` and a suffix:
# user-early is root's interactive login (a console) since systemd 256,
# user-incomplete a login whose home is not ready yet, and the -light
# classes the same logins without a user manager. manager, manager-early,
# background and background-light are not people: the per-user service
# managers lingering keeps up (hcw-coder-docker's rootless daemon, or a
# logged-in user's own manager) and cron-like sessions, so they never defer.
#
# logged_in: set people to the names with a login session open, each once; a logind that cannot answer ends the run.
logged_in() {
  local sessions props id class name key value
  people=''
  sessions="$(loginctl list-sessions --no-legend)" || {
    say err "not rebooting: loginctl could not list the sessions, so the check has not run; its error is in this unit's journal and this run fails"
    exit 1
  }
  while read -r id _; do
    [ -n "${id}" ] || continue
    # A session that ends between the list and this read fails it too: that
    # night is a failed run and a page, not a guess.
    props="$(loginctl show-session "${id}" -p Class -p Name)" || {
      say err "not rebooting: loginctl could not read session ${id}, so the check has not run; its error is in this unit's journal and this run fails"
      exit 1
    }
    class=''
    name=''
    while IFS='=' read -r key value; do
      case "${key}" in
        Class) class="${value}" ;;
        Name) name="${value}" ;;
      esac
    done <<< "${props}"
    case "${class}" in
      user | user-*)
        case " ${people} " in
          *" ${name} "*) ;;
          *) people="${people:+${people} }${name}" ;;
        esac
        ;;
    esac
  done <<< "${sessions}"
}

# A container counts while it is up or about to be: running, paused,
# restarting, or created and not yet started (review of #1191). A `status=`
# filter makes `docker ps` look at every container, not only running ones,
# so `created` is what lets the second look see a job whose `docker run`
# has made its container and not started it yet. Exited and dead ones do
# not count; the agent's unit sweeps those (hcw-labjob-sweep).
up=(--filter status=created --filter status=restarting --filter status=running --filter status=paused)

# Every job container carries the agent's label (vps-agent/lib/docker-runner.js,
# JOB_LABEL), keyed by job id; nothing else on the host does.
#
# running_jobs: set job_count to the containers up with the agent's job label; a docker that cannot answer ends the run.
running_jobs() {
  local running
  running="$(docker ps -q --filter "label=${job_label}" "${up[@]}")" || {
    say err "not rebooting: docker could not list the job containers, so the check has not run; its error is in this unit's journal and this run fails"
    exit 1
  }
  if [ -n "${running}" ]; then
    job_count="$(wc -l <<< "${running}" | tr -d ' ')"
  else
    job_count=0
  fi
}

# Coder's workspaces run on the rootless sandbox daemon (roles/coder_sandbox),
# not the host daemon, and a person working in one has no logind session on
# the host, so neither question above sees them (review of #1191). Every
# workspace container carries coder.workspace_id (lab-host/coder/templates).
# Root reaches the daemon's socket as the Ansible roles already do; it is
# outside /run/user, so ProtectHome= does not hide it. No socket means no
# sandbox daemon (Coder off, or the daemon down, in which case no workspace
# runs either); a daemon that is there and cannot answer is a check that has
# not run. A workspace left running for days defers every night, and the
# overdue line says so from the seventh.
#
# running_workspaces: set workspace_count to the Coder workspaces up on the sandbox daemon; none without its socket, and a daemon that cannot answer ends the run.
running_workspaces() {
  local running
  workspace_count=0
  [ -e "${workspace_docker_host#unix://}" ] || return 0
  running="$(docker --host "${workspace_docker_host}" ps -q --filter "label=${workspace_label}" "${up[@]}")" || {
    say err "not rebooting: the Coder sandbox daemon could not list its workspaces, so the check has not run; its error is in this unit's journal and this run fails"
    exit 1
  }
  if [ -n "${running}" ]; then
    workspace_count="$(wc -l <<< "${running}" | tr -d ' ')"
  fi
}

logged_in
[ -z "${people}" ] || defer "a user is logged in (${people})"
running_jobs
[ "${job_count}" -eq 0 ] || defer "${job_count} job container(s) up"
running_workspaces
[ "${workspace_count}" -eq 0 ] || defer "${workspace_count} Coder workspace(s) up"

# The second look (CodeRabbit on #1191). The first one alone left a gap: a
# job the agent claimed after `docker ps` came back empty, and before the
# reboot request, started a container the reboot then killed. So the script
# writes the maintenance hold, under which the labs agent claims no new job
# (vps-agent/lib/maintenance-hold.js), waits for the agent to acknowledge
# it, and asks the three questions again. The hold holds the epoch second
# it lapses, so a run that dies without removing it cannot keep the agent
# idle past that, and the agent caps any hold at ten minutes from its
# write. Every way out of the script removes it except the reboot it asks
# for: on that path it stays, so no claim lands between the request and
# the manager stopping the agent, and the reboot clears /run. The service's
# RuntimeDirectory= is the hold's directory, the one place it may write.
rebooting=0
# release_hold: remove the hold on every way out but the reboot this run asked for.
release_hold() { [ "${rebooting}" -eq 1 ] || rm -f -- "${hold}" "${hold}.new" || true; }
trap release_hold EXIT
# A stop (TimeoutStartSec, `systemctl stop`, or the reboot's own stop job
# reaching this unit) is a way out too. Bash already runs the EXIT trap
# when a signal it does not trap kills it; these say so here rather than
# leave it to that, and end with the conventional status. The unit counts
# 143 as success (SuccessExitStatus=143), so a stop is not a page; a
# TimeoutStartSec kill still fails the unit, as a timeout.
trap 'exit 143' TERM
trap 'exit 130' INT
trap 'exit 129' HUP

# hold_new_jobs: write the hold, the epoch second it lapses (kept in hold_expiry), readable by the agent, renamed into place so it is never read half written.
hold_new_jobs() {
  hold_expiry="$(( $(date -u +%s) + hold_seconds ))"
  printf '%s\n' "${hold_expiry}" > "${hold}.new" &&
    chmod 0644 "${hold}.new" &&
    mv -f -- "${hold}.new" "${hold}"
}

# The agent's acknowledgement (CodeRabbit's second round on #1191). A fixed
# wait guessed how long a claim already in flight could take to show its
# container, and nothing bounded that guess. Instead the agent, which
# reads the hold on every poll tick, writes this hold's expiry to its
# acknowledgement once no claim is in flight and no job is running. A
# matching acknowledgement is its word that nothing is running and, with
# the hold refusing new claims, that nothing can start, so the second look
# follows at once: no further wait would see anything more. It must name
# this hold's expiry, so one written for an earlier hold never stands in
# for this one. None within settle_seconds (an agent with a job still
# running, a stuck agent, or one too old to acknowledge) defers the night,
# the safe way to be wrong, and the overdue line says so if it lasts.
#
# agent_running: true unless systemd says outright that the labs agent is not running (inactive or failed).
agent_running() {
  local state
  state="$("${systemctl}" is-active "${agent_service}" 2> /dev/null)" || true
  # The state word, not the exit status: a systemctl that cannot reach the
  # manager also exits non-zero, and reading that as "not running" would
  # skip the acknowledgement. Only an agent systemd calls inactive or failed
  # can have no claim in flight; in any other state the script waits.
  case "${state}" in
    inactive | failed) return 1 ;;
    *) return 0 ;;
  esac
}

# acknowledged: true when the agent's acknowledgement names exactly this hold's expiry.
acknowledged() {
  local said
  said="$(head -c 32 -- "${ack}" 2> /dev/null | tr -d '\n')" || said=''
  [ -n "${said}" ] && [ "${said}" = "${hold_expiry}" ]
}

hold_new_jobs || {
  say err "not rebooting: the hold that keeps new lab jobs from starting could not be written, so a second look could not be trusted; its error is in this unit's journal and this run fails"
  exit 1
}
if agent_running; then
  waited=0
  until acknowledged; do
    [ "${waited}" -lt "${settle_seconds}" ] || defer "the lab agent did not confirm it was idle within ${settle_seconds} s"
    sleep 1
    waited=$(( waited + 1 ))
  done
  agent_said='the lab agent confirmed it was idle'
else
  agent_said='the lab agent was not running'
fi
logged_in
[ -z "${people}" ] || defer "a user logged in while new lab jobs were held (${people})"
running_jobs
[ "${job_count}" -eq 0 ] || defer "${job_count} job container(s) started while new lab jobs were held"
running_workspaces
[ "${workspace_count}" -eq 0 ] || defer "${workspace_count} Coder workspace(s) started while new lab jobs were held"

say warning "rebooting; pending since ${since} (${days} days): nobody is logged in and no job container or Coder workspace is up, at both looks, with new lab jobs held between and ${agent_said}"
# `systemctl reboot` enqueues the job and returns (it is `start reboot.target
# --job-mode=replace-irreversibly --no-block` with a wall message), so this
# run ends successfully before the shutdown reaches its unit. The hold stays
# for that. A reboot the manager refuses is a non-zero exit here, the hold
# released, and so a line from the notifier rather than a night silently
# skipped.
rebooting=1
"${systemctl}" reboot || {
  rebooting=0
  exit 1
}
{% endraw %}
