# {{ ansible_managed }}
# Where hcw-backup-upload puts the host's backups, as the Arc machine's
# identity. Names only, no secret. While this file exists the Coder dump
# script uploads the dump it has just written; the backups role removes it
# while backups_enabled is false.
HCW_BACKUPS_ACCOUNT={{ backups_storage_account }}
HCW_BACKUPS_CONTAINER={{ backups_container }}
HCW_BACKUPS_API_VERSION={{ backups_blob_api_version }}
