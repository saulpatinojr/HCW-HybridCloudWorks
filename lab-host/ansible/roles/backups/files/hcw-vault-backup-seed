#!/usr/bin/env bash
# hcw-vault-backup-seed [--force]   (the owner's Vault token on stdin)
#
# The owner's one-time step for the Vault snapshot: with the owner's own
# token, writes the hcw-raft-snapshot policy (read sys/storage/raft/snapshot;
# renew, look up and revoke itself; nothing else) and creates a periodic
# orphan token under it, which hcw-vault-backup.service renews every night
# and which therefore never expires while the snapshots run, and stores it
# root-only in /etc/hcw/backups/vault-token. The Coder rotation credential's
# pattern (roles/coder/README.md, "Coder automation"): one seed, then
# automatic. The owner's line, from the workstation, is in
# docs/runbooks/labs-host.md, "Off-host backups".
#
# Reads the first line of stdin (a byte order mark, carriage return and blanks
# removed); a terminal, an empty line or anything not shaped like a token is
# refused with exit 2 before Vault is asked anything. The token on stdin is
# used for the policy and the token and is kept nowhere. A stored token that
# still works is left alone unless --force is given, and --force revokes the
# one it replaces. Nothing printed holds a token. Exit 0 stored or unchanged,
# 1 when Vault refused, 2 on usage or a refused line.
set -euo pipefail
umask 077

force=0
case "${1:-}" in
  '') ;;
  --force) [ $# -eq 1 ] || { echo 'usage: hcw-vault-backup-seed [--force]   (the owner'"'"'s Vault token on stdin)' >&2; exit 2; }; force=1 ;;
  *) echo 'usage: hcw-vault-backup-seed [--force]   (the owner'"'"'s Vault token on stdin)' >&2; exit 2 ;;
esac

token_file="${HCW_VAULT_BACKUP_TOKEN_FILE:-/etc/hcw/backups/vault-token}"
env_file="${HCW_VAULT_ENV:-/etc/profile.d/hcw-vault.sh}"
vault_bin="${HCW_VAULT_BIN:-/usr/local/bin/vault}"
policy="${HCW_VAULT_BACKUP_POLICY:-hcw-raft-snapshot}"
period="${HCW_VAULT_BACKUP_PERIOD:-720h}"

refuse() { printf 'hcw-vault-backup-seed: %s; nothing was changed\n' "$*" >&2; exit 2; }
fail() { printf 'hcw-vault-backup-seed: %s\n' "$*" >&2; exit 1; }

[ -r "$env_file" ] || fail "no $env_file: the vault role has not run on this host"
# shellcheck source=/dev/null
. "$env_file"
[ -n "${VAULT_ADDR:-}" ] && [ -n "${VAULT_CACERT:-}" ] || fail "$env_file sets no VAULT_ADDR and VAULT_CACERT"
export VAULT_ADDR VAULT_CACERT

stored=''
if [ -f "$token_file" ]; then
  stored="$(tr -d '\r\n' < "$token_file")"
  if [ "$force" -eq 0 ] && [ -n "$stored" ] && VAULT_TOKEN="$stored" "$vault_bin" token lookup >/dev/null 2>&1; then
    echo "hcw-vault-backup-seed: a working snapshot token is already stored in $token_file; nothing was changed (--force replaces it)"
    exit 0
  fi
fi

[ -t 0 ] && refuse 'pipe the owner'"'"'s Vault token in on stdin (docs/runbooks/labs-host.md, "Off-host backups")'
IFS= read -r line || true
line="${line#$'\xEF\xBB\xBF'}"
line="$(printf '%s' "$line" | tr -d '\r' | sed 's/^[[:blank:]]*//; s/[[:blank:]]*$//')"
[ -n "$line" ] || refuse 'the token on stdin was empty'
[[ "$line" =~ ^[A-Za-z0-9._-]{20,}$ ]] || refuse 'the first line on stdin is not a Vault token (letters, digits, . _ and -)'
export VAULT_TOKEN="$line"
unset line

"$vault_bin" token lookup >/dev/null 2>&1 \
  || fail 'Vault did not accept the token on stdin: it has expired or been revoked, or Vault is sealed (sudo systemctl status vault)'

# The policy: the snapshot read and the token's own upkeep, nothing else.
printf '%s\n' \
  'path "sys/storage/raft/snapshot" { capabilities = ["read"] }' \
  'path "auth/token/renew-self" { capabilities = ["update"] }' \
  'path "auth/token/lookup-self" { capabilities = ["read"] }' \
  'path "auth/token/revoke-self" { capabilities = ["update"] }' \
  | "$vault_bin" policy write "$policy" - >/dev/null \
  || fail "writing the $policy policy failed: the token on stdin cannot write policies (the root token can)"

# Periodic, so each renewal gives it the whole period again; orphan, so
# revoking the owner's token afterwards does not take it along.
new="$("$vault_bin" token create -policy="$policy" -no-default-policy -orphan -period="$period" -display-name=hcw-vault-backup -field=token)" \
  || fail 'creating the snapshot token failed: the token on stdin cannot create orphan periodic tokens (the root token can)'
[[ "$new" =~ ^[A-Za-z0-9._-]{20,}$ ]] || fail 'Vault answered the token create with something that is not a token'

mkdir -p "$(dirname -- "$token_file")"
tmp="$(mktemp "$(dirname -- "$token_file")/.vault-token.XXXXXX")"
printf '%s\n' "$new" > "$tmp"
chmod 600 "$tmp"
if [ "$(id -u)" -eq 0 ]; then chown root:root "$tmp"; fi
mv -f "$tmp" "$token_file"

if [ -n "$stored" ] && [ "$stored" != "$new" ]; then
  VAULT_TOKEN="$stored" "$vault_bin" token revoke -self >/dev/null 2>&1 || true
fi
expires="$(VAULT_TOKEN="$new" "$vault_bin" token lookup -format=json | tr -d '\n' | sed -n 's/.*"expire_time"[[:blank:]]*:[[:blank:]]*"\([^"]*\)".*/\1/p' | head -n 1)"
echo "hcw-vault-backup-seed: stored the snapshot token for policy $policy in $token_file; hcw-vault-backup.service renews it nightly, and unrenewed it expires on ${expires:-a date Vault did not report}. Take the first snapshot now: sudo systemctl start hcw-vault-backup.service"
