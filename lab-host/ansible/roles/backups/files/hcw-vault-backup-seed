#!/usr/bin/env bash
# hcw-vault-backup-seed [--force]   (the owner's Vault token on stdin)
#
# The owner's one-time step for the Vault snapshot: with the owner's own
# token, writes the hcw-raft-snapshot policy (read sys/storage/raft/snapshot;
# renew, look up and revoke itself; nothing else) and creates a periodic
# orphan token under it, which hcw-vault-backup.service renews every night
# and which therefore never expires while the snapshots run, and stores it
# root-only in /etc/hcw/backups/vault-token, with its accessor beside it in
# vault-token.accessor. The Coder rotation credential's pattern
# (roles/coder/README.md, "Coder automation"): one seed, then automatic. The
# owner's line, from the workstation, is in docs/runbooks/labs-host.md,
# "Off-host backups".
#
# Reads the first line of stdin (a byte order mark, carriage return and blanks
# removed); a terminal, an empty line or anything not shaped like a token is
# refused with exit 2 before Vault is asked anything. The token on stdin is
# used for the policy, the token and the revocations and is kept nowhere.
#
# The token's lifecycle is a reconciliation, not a hope. One seed runs at a
# time (a lock beside the token file). A token created but not stored is
# revoked again before the seed fails. Replacing a token first records the
# old one's accessor in /etc/hcw/backups/revoke-pending, then publishes the
# new token, then revokes everything pending: an interruption between those
# steps leaves the intent on disk, and every run, forced or not, works the
# pending list before anything else, with the owner's token. The one record
# never revoked from that list is the one Vault itself says names the token
# in the file: that is a replacement that did not happen, dropped. Only
# Vault's answer protects a record; the accessor copy beside the token is
# used to record a retirement, never to spare one. An accessor leaves the
# list only that way, or when Vault revoked it or says it no longer exists;
# a revocation that fails for any other reason stays, is said on stderr with
# the exact line to run by hand, and is retried next run. A plain run
# replaces a stored token that no longer works; --force replaces one that
# does. "Nothing was changed" is said only of a stored token that still works
# after the list was worked. Nothing printed holds a token. Exit 0 stored or
# unchanged, 1 when Vault refused, 2 on usage, a refused line or another seed
# running.
set -euo pipefail
umask 077

usage() { echo 'usage: hcw-vault-backup-seed [--force]   (the owner'"'"'s Vault token on stdin)' >&2; exit 2; }
force=0
case "${1:-}" in
  '') [ $# -eq 0 ] || usage ;;
  --force) [ $# -eq 1 ] || usage; force=1 ;;
  *) usage ;;
esac

token_file="${HCW_VAULT_BACKUP_TOKEN_FILE:-/etc/hcw/backups/vault-token}"
accessor_file="${token_file}.accessor"
dir="$(dirname -- "$token_file")"
pending_file="$dir/revoke-pending"
lock_file="${token_file}.lock"
env_file="${HCW_VAULT_ENV:-/etc/profile.d/hcw-vault.sh}"
vault_bin="${HCW_VAULT_BIN:-/usr/local/bin/vault}"
policy="${HCW_VAULT_BACKUP_POLICY:-hcw-raft-snapshot}"
period="${HCW_VAULT_BACKUP_PERIOD:-720h}"

refuse() { printf 'hcw-vault-backup-seed: %s; nothing was changed\n' "$*" >&2; exit 2; }
fail() { printf 'hcw-vault-backup-seed: %s\n' "$*" >&2; exit 1; }
warn() { printf 'hcw-vault-backup-seed: WARNING: %s\n' "$*" >&2; }
say() { printf 'hcw-vault-backup-seed: %s\n' "$*"; }
# One JSON string value, from the CLI's -format=json output.
json_value() { tr -d '\n' | sed -n "s/.*\"$1\"[[:blank:]]*:[[:blank:]]*\"\([^\"]*\)\".*/\1/p" | head -n 1; }
# Replace a root-only file's contents by rename, so it is whole or unchanged.
write_atomically() {
  local target="$1" tmp
  tmp="$(mktemp "$dir/.$(basename -- "$target").XXXXXX")" || return 1
  if cat > "$tmp" && chmod 600 "$tmp" && { [ "$(id -u)" -ne 0 ] || chown root:root "$tmp"; } && mv -f "$tmp" "$target"; then
    return 0
  fi
  rm -f "$tmp"
  return 1
}
pending_add() {
  { [ -f "$pending_file" ] && cat "$pending_file"; printf '%s\n' "$1"; } | awk 'NF && !seen[$0]++' | write_atomically "$pending_file"
}
pending_remove() {
  [ -f "$pending_file" ] || return 0
  local kept
  kept="$(awk -v drop="$1" 'NF && $0 != drop' "$pending_file")"
  if [ -n "$kept" ]; then printf '%s\n' "$kept" | write_atomically "$pending_file"; else rm -f "$pending_file"; fi
}
# The accessor Vault knows a token by, from Vault; empty when Vault does not
# answer for it (expired, revoked, sealed, unreachable).
vault_accessor() {
  [ -n "${1:-}" ] || return 0
  VAULT_TOKEN="$1" "$vault_bin" token lookup -format=json 2>/dev/null | json_value accessor || true
}
# Revoke every accessor recorded as pending, except the one Vault says names
# the token still in the file ($1, empty when there is no such answer): that
# record is a replacement that never completed, and revoking it would take
# the working token away. An accessor leaves the list when Vault revoked it,
# or says it no longer exists; anything else (a refused revocation, Vault
# unreachable) keeps it, said and retried next run.
pending_work() {
  local protected="${1:-}"
  [ -s "$pending_file" ] || { rm -f "$pending_file"; return 0; }
  local accessor kept='' lookup
  while IFS= read -r accessor; do
    [ -n "$accessor" ] || continue
    if [ -n "$protected" ] && [ "$accessor" = "$protected" ]; then
      say "the record for accessor $accessor was a replacement that did not complete; the stored token keeps working and the record is dropped"
      continue
    fi
    if "$vault_bin" token revoke -accessor "$accessor" >/dev/null 2>&1; then
      say "revoked the superseded snapshot token with accessor $accessor"
      continue
    fi
    lookup="$("$vault_bin" token lookup -accessor "$accessor" 2>&1 >/dev/null || true)"
    if printf '%s' "$lookup" | grep -qi 'invalid accessor'; then
      say "the superseded snapshot token with accessor $accessor no longer exists in Vault"
      continue
    fi
    kept="${kept}${accessor}"$'\n'
    warn "a superseded snapshot token (accessor $accessor) could not be revoked and may still be valid; it stays in $pending_file and is retried next run, or revoke it now: vault token revoke -accessor $accessor"
  done < "$pending_file"
  if [ -n "$kept" ]; then printf '%s' "$kept" | write_atomically "$pending_file"; else rm -f "$pending_file"; fi
}

[ -r "$env_file" ] || fail "no $env_file: the vault role has not run on this host"
# shellcheck source=/dev/null
. "$env_file"
[ -n "${VAULT_ADDR:-}" ] && [ -n "${VAULT_CACERT:-}" ] || fail "$env_file sets no VAULT_ADDR and VAULT_CACERT"
export VAULT_ADDR VAULT_CACERT

# One seed at a time: two at once would mint two tokens and store one.
mkdir -p "$dir" 2>/dev/null || fail "cannot create $dir; nothing was asked of Vault"
if command -v flock >/dev/null 2>&1; then
  exec 9>"$lock_file"
  flock -n 9 || refuse 'another hcw-vault-backup-seed is running'
fi

stored=''
[ -f "$token_file" ] && stored="$(tr -d '\r\n' < "$token_file")"
# Nothing to do, and nothing pending: say so without asking for a token.
if [ "$force" -eq 0 ] && [ -n "$stored" ] && ! [ -s "$pending_file" ] && VAULT_TOKEN="$stored" "$vault_bin" token lookup >/dev/null 2>&1; then
  say "a working snapshot token is already stored in $token_file; nothing was changed (--force replaces it)"
  exit 0
fi

[ -t 0 ] && refuse 'pipe the owner'"'"'s Vault token in on stdin (docs/runbooks/labs-host.md, "Off-host backups")'
IFS= read -r line || true
line="${line#$'\xEF\xBB\xBF'}"
line="$(printf '%s' "$line" | tr -d '\r' | sed 's/^[[:blank:]]*//; s/[[:blank:]]*$//')"
[ -n "$line" ] || refuse 'the token on stdin was empty'
[[ "$line" =~ ^[A-Za-z0-9._-]{20,}$ ]] || refuse 'the first line on stdin is not a Vault token (letters, digits, . _ and -)'
export VAULT_TOKEN="$line"
unset line

"$vault_bin" token lookup >/dev/null 2>&1 \
  || fail 'Vault did not accept the token on stdin: it has expired or been revoked, or Vault is sealed (sudo systemctl status vault)'

# Unfinished business first: revocations an earlier run recorded and could
# not finish. The only record spared is the one Vault itself says names the
# token in the file; no answer from Vault spares nothing.
stored_accessor="$(vault_accessor "$stored")"
pending_work "$stored_accessor"

# Whether the stored token works is judged now, after the list was worked,
# not from the reading taken before it.
if [ "$force" -eq 0 ] && [ -n "$stored" ] && VAULT_TOKEN="$stored" "$vault_bin" token lookup >/dev/null 2>&1; then
  say "a working snapshot token is already stored in $token_file; nothing else was changed (--force replaces it)"
  exit 0
fi
if [ "$force" -eq 0 ] && [ -n "$stored" ]; then
  say "the stored snapshot token no longer works; replacing it"
fi

# The policy: the snapshot read and the token's own upkeep, nothing else.
printf '%s\n' \
  'path "sys/storage/raft/snapshot" { capabilities = ["read"] }' \
  'path "auth/token/renew-self" { capabilities = ["update"] }' \
  'path "auth/token/lookup-self" { capabilities = ["read"] }' \
  'path "auth/token/revoke-self" { capabilities = ["update"] }' \
  | "$vault_bin" policy write "$policy" - >/dev/null \
  || fail "writing the $policy policy failed: the token on stdin cannot write policies (the root token can)"

# Periodic, so each renewal gives it the whole period again; orphan, so
# revoking the owner's token afterwards does not take it along. The accessor
# identifies the token in Vault without being usable as one.
created="$("$vault_bin" token create -policy="$policy" -no-default-policy -orphan -period="$period" -display-name=hcw-vault-backup -format=json)" \
  || fail 'creating the snapshot token failed: the token on stdin cannot create orphan periodic tokens (the root token can)'
new="$(printf '%s' "$created" | json_value client_token)"
new_accessor="$(printf '%s' "$created" | json_value accessor)"
unset created
[[ "$new" =~ ^[A-Za-z0-9._-]{20,}$ ]] || fail 'Vault answered the token create with something that is not a token'
[ -n "$new_accessor" ] || fail 'Vault answered the token create without an accessor'

# A token that exists in Vault and in no file is one nothing renews and
# nothing can find, so a token that cannot be stored is revoked again, and
# the retirement this run recorded for its predecessor is withdrawn: the
# predecessor stays the stored token, untouched.
enqueued=''
unpublished() {
  VAULT_TOKEN="$new" "$vault_bin" token revoke -self >/dev/null 2>&1 \
    || warn "the token just created could not be revoked either; revoke it by hand: vault token revoke -accessor $new_accessor"
  if [ -n "$enqueued" ]; then
    pending_remove "$enqueued" || warn "the previous token's accessor $enqueued stays in $pending_file; the next run drops it as the stored token's own"
  fi
  fail "$*"
}

# Retirement intent before publication: the token being replaced is recorded
# as pending before the new one is in place, so an interruption between the
# two leaves a run that finishes the job rather than a stranded predecessor.
# The accessor is Vault's answer for the stored token, or, when Vault no
# longer answers for it, the copy kept beside it: recording a stale accessor
# costs one revocation that Vault refuses as invalid, recording none loses a
# token.
old_accessor="$stored_accessor"
if [ -z "$old_accessor" ] && [ -n "$stored" ] && [ -f "$accessor_file" ]; then old_accessor="$(tr -d '\r\n' < "$accessor_file")"; fi
if [ -n "$old_accessor" ] && [ "$old_accessor" != "$new_accessor" ]; then
  pending_add "$old_accessor" || unpublished "cannot record the previous token's accessor in $pending_file; the token just created was revoked again"
  enqueued="$old_accessor"
fi

printf '%s\n' "$new" | write_atomically "$token_file" || unpublished "cannot write $token_file; the token just created was revoked again"
printf '%s\n' "$new_accessor" | write_atomically "$accessor_file" \
  || warn "the accessor could not be written to $accessor_file; it is $new_accessor, and the next run asks Vault for it rather than trusting the file"

# A predecessor that still works but whose accessor nothing reported: revoke
# it by itself, now that the new token is in place and nothing depends on it.
if [ -z "$old_accessor" ] && [ -n "$stored" ] && VAULT_TOKEN="$stored" "$vault_bin" token lookup >/dev/null 2>&1; then
  VAULT_TOKEN="$stored" "$vault_bin" token revoke -self >/dev/null 2>&1 \
    || warn 'the previous snapshot token could not be revoked and Vault did not report its accessor; it expires unrenewed within its period'
fi
unset new stored

# Now the retirement itself, with the owner's token. The token just stored is
# protected by its accessor, which is never on the list.
pending_work "$new_accessor"

expires="$(VAULT_TOKEN="$(cat "$token_file")" "$vault_bin" token lookup -format=json 2>/dev/null | json_value expire_time || true)"
say "stored the snapshot token for policy $policy in $token_file (accessor $new_accessor); hcw-vault-backup.service renews it nightly, and unrenewed it expires on ${expires:-a date Vault did not report}. Take the first snapshot now: sudo systemctl start hcw-vault-backup.service"
