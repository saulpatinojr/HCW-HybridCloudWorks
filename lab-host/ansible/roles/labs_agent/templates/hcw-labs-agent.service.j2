# {{ ansible_managed }}
[Unit]
Description=HCW Labs VPS agent (vps-agent)
# Say so where Azure can hear it on every failure (LAB-2). With systemd's
# default RestartMode=normal that includes each one Restart= retries, not
# only the last (systemd 259; review of #1188).
OnFailure=hcw-unit-failed@%n.service
Documentation=https://github.com/saulpatinojr/HCW-HybridCloudWorks/tree/main/vps-agent
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User={{ labs_agent_user }}
Group={{ labs_agent_group }}
WorkingDirectory={{ labs_agent_app_dir }}
EnvironmentFile={{ labs_agent_env_file }}
Environment=NODE_ENV=production
# lib/docker-runner.js stages each payload under os.tmpdir() and bind-mounts
# it into the job container. PrivateTmp below gives this unit a /tmp the
# Docker daemon cannot see, so TMPDIR points at a real host directory instead.
Environment=TMPDIR={{ labs_agent_tmp_dir }}
# The docker CLI the runner spawns reaches Docker through the agent's own
# socket proxy, never the daemon's socket: this user is in no docker group
# (LAB-5, 2026-10-07; roles/labs_agent/templates/docker-proxy.haproxy.cfg.j2
# is the allowlist). Until Docker has started the proxy there is no socket,
# so the start fails here and Restart= tries again ten seconds later.
Environment=DOCKER_HOST={{ labs_agent_docker_host }}
ExecStartPre=/usr/bin/test -S {{ labs_agent_docker_proxy_socket }}
ExecStart=/usr/bin/node index.js
# Stopping (LAB-13, #959). SIGTERM goes to the agent alone, not to the docker
# CLI children it spawns: the agent interrupts each running job itself,
# starts removing its container through the proxy, reports it without
# waiting for the removal, then exits
# (vps-agent/lib/shutdown.js). With the default control-group mode the CLI
# got SIGTERM at the same instant and forwarded it to the job. What is still
# running when the agent exits, or at TimeoutStopSec, gets SIGKILL. The
# timeout covers LABS_AGENT_SHUTDOWN_TIMEOUT_MS and the two 5 s shutdown
# heartbeats with margin; scripts/lab-job-limits.test.mjs holds the sum and
# tests/hcw-labs-agent.service.test.sh the rendered lines.
KillMode=mixed
TimeoutStopSec={{ labs_agent_timeout_stop_sec }}
# The agent's report window is shorter than a container removal can take,
# and a crash removes nothing, so the containers themselves are this unit's
# to clean up, not the process's (CodeRabbit on #1188): after the agent
# exits, for a stop and a crash alike, and again before it starts, so a host
# that went down mid-job is swept before the first claim, every container
# with the job label is removed. No agent runs at either point, so each one
# is an orphan. The sweep judges by what is left running, not by what
# `docker rm` answered, because the agent's own removal may still be at work
# when it runs, and fails only on a container still running at its 20 s
# deadline, inside TimeoutStopSec. `+` runs the sweep as root on the daemon's own
# socket, because the proxy above lists no containers; the agent itself
# keeps none of that privilege (files/hcw-labjob-sweep,
# tests/hcw-labjob-sweep.test.sh).
ExecStartPre=+/usr/local/libexec/hcw-labjob-sweep
ExecStopPost=+/usr/local/libexec/hcw-labjob-sweep
# The agent starts its error lines with <3> and its warnings with <4>
# (vps-agent/lib/log.js), and journald turns that prefix into the line's
# priority. systemd's default, written down because the data collection rule
# collects the daemon facility at Warning and above only: without it every
# agent error would land at info and never reach Log Analytics (#1009).
SyslogLevelPrefix=true
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
# The agent's acknowledgement of the host's maintenance hold (LAB-13, #959;
# vps-agent/lib/maintenance-hold.js): it writes the hold's expiry here once
# no claim is in flight and no job is running, and hcw-reboot-when-idle
# reads it, as root, before its second look. A RuntimeDirectory= is the
# agent user's, writable whatever ProtectSystem= says (full leaves /run
# alone in any case) and outside /run/user, which ProtectHome= hides; 0755
# so root's script reads it. Not preserved: systemd removes it whenever the
# agent stops, a crash or a Restart= included, so no acknowledgement
# outlives the process that wrote it.
RuntimeDirectory={{ labs_agent_maintenance_ack_path | dirname | basename }}
RuntimeDirectoryMode=0755
# Added 2026-10-06 (LAB-5): the agent is a Node process that spawns the
# docker CLI, which needs AF_UNIX for the proxy's socket and AF_INET/AF_INET6
# for the API; nothing else. @system-service is the systemd set a service needs;
# the rest closes kernel tunables, modules, cgroups, setuid and realtime.
# MemoryDenyWriteExecute is deliberately NOT set: V8 JIT needs W^X memory.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
