# {{ ansible_managed }}
[Unit]
Description=Caddy
# A Caddy that stays down is every lab name dark; one syslog line, one alert (LAB-2).
OnFailure=hcw-unit-failed@%n.service
Documentation=https://caddyserver.com/docs/
After=network.target network-online.target
Requires=network-online.target

[Service]
Type=notify
User={{ caddy_user }}
Group={{ caddy_group }}
EnvironmentFile={{ caddy_env_file }}
# The admin API's socket lives here (#958): systemd creates the directory
# for the caddy user at start and removes it at stop, so a socket in it was
# made by the Caddy running now. 0700 because only the caddy user and root
# have any business in it.
RuntimeDirectory=caddy
RuntimeDirectoryMode=0700
ExecStart={{ caddy_binary_path }} run --config {{ caddy_config_dir }}/Caddyfile --adapter caddyfile
ExecReload={{ caddy_binary_path }} reload --config {{ caddy_config_dir }}/Caddyfile --adapter caddyfile --address {{ caddy_admin_address }} --force
TimeoutStopSec=5s
LimitNOFILE=1048576
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
