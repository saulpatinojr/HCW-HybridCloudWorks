# {{ ansible_managed }}
# Global options, always rendered (#958).
# - admin: the admin API (and the metrics it serves) on a Unix socket in the
#   unit's RuntimeDirectory, not on TCP. Only the caddy user and root can
#   connect to it, by file permission; the unit's ExecReload names the same
#   socket with --address.
# - protocols h1 h2: no HTTP/3, so Caddy neither listens on UDP 443 nor
#   advertises h3 in Alt-Svc. ufw admits TCP 80 and 443 only.
{
  admin {{ caddy_admin_address }}
  servers {
    protocols h1 h2
  }
{% if caddy_acme_email | length > 0 %}
  email {{ caddy_acme_email }}
{% endif %}
}

# Panes only. Owner decision 2026-09-28: "The lab should only be accessible
# through 'panes' from my site, lock to that", and a direct visit goes to the
# site's labs page. Imported first into the site block below, and Caddy runs
# it before any route, so it covers every name served here (the apex, every
# *.lab name, coder.lab and *.coder.lab) and every response, including the
# 404 for a name no route claims and any route added later.
# docs/architecture/labs-host.md, "Panes only", has the reasoning.
(lab_panes_only) {
  # 1. Only the site may frame the lab. This uses frame-ancestors, not
  #    X-Frame-Options, because X-Frame-Options cannot name an allowed origin.
  #    'self' is for code-server, whose webviews (Markdown preview, extension
  #    pages) are iframes of its own origin. frame-ancestors checks every
  #    ancestor up to the top window, which is the site, so 'self' admits no
  #    other site. The header is set at once, not deferred: a proxied
  #    upstream's own policy arrives beside it and the browser enforces both.
  #    That is why 10-coder.caddy strips Coder's default frame-ancestors.
  #    Vary: the same URL answers a pane and a top-level visit differently,
  #    so a response cached for one must never be reused for the other.
  header {
    Content-Security-Policy "frame-ancestors {{ caddy_frame_ancestors | join(' ') }}"
    +Vary "Sec-Fetch-Dest, Sec-Fetch-Mode"
  }

  # 2. No direct browsing. A browser sends Sec-Fetch-Dest to say what a
  #    request is for, and no page can forge it (Sec- is a forbidden header
  #    prefix). The matcher selects a top-level visit:
  #    - Sec-Fetch-Dest: document is a top-level navigation: the address
  #      bar, a bookmark, a link opened in a new tab, a window.open popup.
  #    - No Sec-Fetch-Dest with Sec-Fetch-Mode: navigate is a navigation from
  #      a browser that sends fetch metadata but not the destination
  #      (Chromium 76 to 79), so nothing shows it is inside a pane.
  #    Everything else passes:
  #    - iframe and frame: the site's panes.
  #    - empty: fetch, XHR and WebSockets from a page in a pane, which is
  #      how Coder's dashboard, terminal and code-server reach Coder's API.
  #      A browser that labels a WebSocket websocket instead passes too.
  #    - script, style, image, font, worker and the rest: subresources of a
  #      page in a pane.
  #    - No Sec-Fetch-Dest and no navigate: Coder's workspace agents and its
  #      CLI, curl, and the site's status proxy in the Function App (Node's
  #      fetch sends Sec-Fetch-Mode: cors and no destination). A browser too
  #      old to send fetch metadata (Safari before 16.4) also passes, because
  #      nothing in its requests tells it apart from those clients.
  #    Any script can send these headers, so this is a browsing rule, not
  #    access control; Coder's GitHub sign-in is the access control. ACME
  #    never reaches this rule: certificates come by DNS-01, and Caddy
  #    answers an HTTP challenge on port 80 before any route. Caddy's admin
  #    API and metrics listen on a Unix socket (global options), not here.
  #    A route opts a request out by setting the variable
  #    lab_top_level_allowed, and only for a request that must work at the
  #    top level and shows no page there. 10-coder.caddy does this for
  #    GitHub sign-in; nothing else does.
  #    Where the visit goes is the variable lab_direct_visit_redirect, set
  #    here for every name and read by the redir below as a placeholder.
  #    A route may set it again for its own name (20-addons.caddy sends a
  #    visit to an add-on's name to that add-on's page on the site): Caddy
  #    orders every vars directive ahead of redir, and a later vars for the
  #    same key wins (ADR 0035; checked with caddy adapt, roles/caddy/README.md,
  #    "Panes only").
  vars lab_direct_visit_redirect {{ caddy_direct_visit_redirect }}
  @lab_direct_visit {
    expression `{http.request.header.Sec-Fetch-Dest} == "document" || ({http.request.header.Sec-Fetch-Dest} == "" && {http.request.header.Sec-Fetch-Mode} == "navigate")`
    not vars lab_top_level_allowed true
  }
  redir @lab_direct_visit {vars.lab_direct_visit_redirect} 302
}

{% if caddy_tls_enabled | bool %}
{{ caddy_site_names | join(', ') }} {
  tls {
    dns cloudflare {env.CLOUDFLARE_API_TOKEN}
    resolvers 1.1.1.1 1.0.0.1
  }

  import lab_panes_only

  import {{ caddy_sites_dir }}/*.caddy

  handle {
    respond "{{ caddy_unknown_host_response }}" 404
  }
}
{% else %}
# Fail closed. Without the DNS token nothing from conf.d is served, so a
# missing secret can never expose an application route over plaintext.
http://{{ caddy_site_domain }} {
  import lab_panes_only

  # The one body here that names a setting: it is for the operator, and only
  # a command-line client reads it. The site's https pages cannot frame an
  # http:// address (a browser blocks mixed content in a frame), and
  # lab_panes_only sends a top-level visit to the labs page first.
  respond "TLS is off: vault_cloudflare_api_token is not set." 503
}
{% endif %}
