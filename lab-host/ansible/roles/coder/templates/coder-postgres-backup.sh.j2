#!/usr/bin/env bash
# {{ ansible_managed }}
# Nightly pg_dump of Coder's PostgreSQL into {{ coder_backup_dir }}, keeping
# {{ coder_backup_keep_days }} days. A convenience against operator error,
# not a backup promise: the database is rebuildable metadata
# (docs/architecture/labs-host.md). While off-host backups are on (the
# backups role has written /etc/hcw/backups/upload.env) the dump just written
# is also uploaded to the host-backups container as the Arc identity (LAB-9).
# Run by {{ coder_backup_unit_name }}.timer; run it by hand with
#   sudo {{ coder_backup_script_path }}
# Success is a new coder-<UTC timestamp>.sql.gz in the directory and exit 0.
set -euo pipefail
umask 077

backup_dir='{{ coder_backup_dir }}'
project_dir='{{ coder_project_dir }}'
keep_minutes='{{ coder_backup_keep_minutes }}'
stamp="$(date -u +%Y%m%dT%H%M%SZ)"
target="${backup_dir}/coder-${stamp}.sql.gz"

mkdir -p "$backup_dir"
# Write to a .partial and rename, so a failed dump never looks like a backup.
# pipefail makes a pg_dump failure fail the pipeline even though gzip exits 0.
docker compose --project-directory "$project_dir" exec -T coder-postgres \
  pg_dump --username coder --dbname coder --no-owner --no-privileges \
  | gzip -9 > "${target}.partial"
mv "${target}.partial" "$target"

find "$backup_dir" -maxdepth 1 -type f -name 'coder-*.sql.gz' -mmin "+${keep_minutes}" -delete
find "$backup_dir" -maxdepth 1 -type f -name 'coder-*.sql.gz.partial' -mmin '+60' -delete

# Off the host too (roles/backups): while the backups role has written its
# upload.env, backups_enabled, the dump just written goes to the
# host-backups container as the Arc identity. A failed upload fails this run,
# so the timer's OnFailure= says so; the dump stays here either way.
if [ -r /etc/hcw/backups/upload.env ]; then
  /usr/local/sbin/hcw-backup-upload coder "$target"
fi
