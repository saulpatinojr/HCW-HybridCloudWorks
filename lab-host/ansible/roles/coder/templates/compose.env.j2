# {{ ansible_managed }}
# Compose interpolation for {{ coder_compose_file }}. Not secret: the three
# image pins from group_vars/all.yml, and the sha256 of the proxy's allowlist
# (lab-host/coder/docker-proxy.haproxy.cfg), which labels the proxy so that a
# changed file recreates it.
CODER_IMAGE={{ coder_image_ref }}
CODER_POSTGRES_IMAGE={{ coder_postgres_image_ref }}
CODER_DOCKER_PROXY_IMAGE={{ coder_docker_proxy_image_ref }}
CODER_DOCKER_PROXY_CONFIG_SHA256={{ coder_docker_proxy_config_sha256 }}
