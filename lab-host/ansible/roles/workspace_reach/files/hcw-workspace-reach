#!/usr/bin/env bash
# hcw-workspace-reach: a lab workspace's first minute, checked
# (roles/workspace_reach; #1267).
#
# Starts one throwaway container on the Coder sandbox daemon, shaped the way
# lab-host/coder/templates/hcw-lab/main.tf shapes a workspace: the workspace
# image, uid 65534, every capability dropped, no privilege gain, on a bridge
# network of its own, and with no nameserver of its own, so it gets what the
# daemon gives every workspace. The image is the newest of the template's
# repository on the daemon, the pin lab_images keeps there, read at every run
# so a narrowed run that moves the pin never leaves this check naming a digest
# that is gone. It is created the way the Terraform docker provider creates a
# workspace (kreuzwerker/docker 4.6.0): on the default bridge, then
# disconnected from it and connected to its own network, then started. That
# order decides which nameservers a container gets
# (roles/coder_sandbox/README.md, "Workspace DNS"). `docker run --network`
# takes the other path, and on 2026-10-17 it resolved on the very host where
# no workspace could (#1267). From inside it, the two things a workspace does
# before a learner sees anything:
#
#   1. resolve the name in Coder's access URL and fetch the start of the agent
#      from <url>/bin/coder-linux-amd64. Coder's init script does that first,
#      and retries it forever when it cannot, which the learner sees as
#      "Agent is taking longer than expected to connect";
#   2. reach the lab repository a lab's startup script checks its folder out
#      of (git ls-remote).
#
# Run as the sandbox daemon's user, by the timer and by the play alike. Each
# attempt asks the daemon, finds the image and runs the container; it makes
# HCW_REACH_ATTEMPTS of them (default 3), HCW_REACH_WAIT seconds apart
# (default 20), so a daemon or Coder restarting at that moment is not reported.
#
# Usage: hcw-workspace-reach <docker-host> <image-repository> <coder-url> <repo-url>
# Exits 0 when both work and 1 when one does not after every attempt; the last
# line then says which, what the tool itself said, and what to read. Exits 2
# on a usage error.
set -euo pipefail

if [ "$#" -ne 4 ]; then
  echo "usage: hcw-workspace-reach <docker-host> <image-repository> <coder-url> <repo-url>" >&2
  exit 2
fi

docker_host=$1
repository=$2
coder_url=${3%/}
repo_url=$4
attempts=${HCW_REACH_ATTEMPTS:-3}
wait_seconds=${HCW_REACH_WAIT:-20}
container=hcw-workspace-reach
network=hcw-workspace-reach
runbook='docs/runbooks/labs-host.md, "Workspace reach"'
coder_host=${coder_url#*://}
coder_host=${coder_host%%/*}
coder_host=${coder_host%%:*}

# One line of the check's own, on stdout.
say() { echo "workspace reach: $*"; }
# The check's verdict when something is wrong: one line on stderr, naming the
# runbook section, and exit 1, which fails the unit and the play.
fail() {
  echo "workspace reach: FAILED: $* (${runbook})" >&2
  exit 1
}

# One check at a time: the timer and a bootstrap run can meet. The lock is the
# script itself, which every caller can read.
exec 9<"$0"
flock -w 600 9 || fail "another check held the lock for ten minutes"

# The CLI's own state in a directory of this run's, not in the user's home.
DOCKER_CONFIG=$(mktemp -d)
export DOCKER_CONFIG
# Every docker call goes to the sandbox daemon, never to a default socket.
docker() { command docker -H "${docker_host}" "$@"; }

# Anything an earlier run left (a killed run cannot clean up after itself),
# and this run's own, on the way out.
remove_ours() {
  docker rm -f "${container}" >/dev/null 2>&1 || true
  docker network rm "${network}" >/dev/null 2>&1 || true
}
trap 'remove_ours; rm -rf "${DOCKER_CONFIG}"' EXIT

# What runs inside, as the workspace's own user. A constant: the URLs reach it
# as environment variables, never as part of the script.
# shellcheck disable=SC2016 # expanded inside the container, not here
inner='
set -u
getent hosts "${HCW_CODER_HOST}" >/dev/null || exit 11
curl -fsS --max-time 30 -r 0-99 -o /dev/null "${HCW_CODER_URL}/bin/coder-linux-amd64" || exit 12
GIT_TERMINAL_PROMPT=0 timeout 60 git ls-remote --exit-code "${HCW_REPO_URL}" HEAD >/dev/null || exit 13
'

# One attempt: its status, and what was said, in ${status} and ${output}.
# 20: the daemon did not answer. 21: no image of the repository is on it.
# 125: a docker call before the start failed. Otherwise the container's own
# status from `docker start --attach`. The container has the workspace's shape
# (template.test.mjs holds the template to it): no --dns, no --privileged, no
# mount, no published port, and is created on the default bridge and moved,
# as the provider does it.
attempt_once() {
  local image
  if ! output=$(docker version --format '{{.Server.Version}}' 2>&1 >/dev/null); then
    status=20
    return
  fi
  # Newest first, which is the order `docker image ls` lists in. A daemon that
  # stops answering here is the next attempt's to report, not a crash.
  image=$(docker image ls --quiet --no-trunc --filter "reference=${repository}" 2>/dev/null | head -n 1) || true
  if [ -z "${image}" ]; then
    output=""
    status=21
    return
  fi
  if ! output=$(docker network create --driver bridge --label hcw.workspace-reach=true "${network}" 2>&1 >/dev/null); then
    status=125
    return
  fi
  set +e
  output=$(
    docker create --name "${container}" --network bridge --pull never \
      --user 65534:65534 --cap-drop ALL --security-opt no-new-privileges:true \
      --memory 256m --memory-swap 256m --cpus 0.5 --pids-limit 128 \
      --label hcw.workspace-reach=true \
      --env HOME=/tmp/home \
      --env "HCW_CODER_HOST=${coder_host}" \
      --env "HCW_CODER_URL=${coder_url}" \
      --env "HCW_REPO_URL=${repo_url}" \
      --entrypoint sh "${image}" -c "${inner}" 2>&1 >/dev/null || exit 125
    docker network disconnect bridge "${container}" 2>&1 || exit 125
    docker network connect "${network}" "${container}" 2>&1 || exit 125
    docker start --attach "${container}" 2>&1
  )
  status=$?
  set -e
  used_image=${image}
}

attempt=1
while :; do
  remove_ours
  attempt_once
  remove_ours
  [ "${status}" -eq 0 ] && break
  if [ "${attempt}" -ge "${attempts}" ]; then
    break
  fi
  say "attempt ${attempt} of ${attempts} did not come through (exit ${status}); trying again in ${wait_seconds} s" >&2
  sleep "${wait_seconds}"
  attempt=$((attempt + 1))
done

# The last lines the tool itself printed (curl's, git's, the daemon's), which
# tell a 404 from a certificate error from a refused connection.
said() {
  local words
  words=$(printf '%s' "${output}" | grep -v '^[[:space:]]*$' | tail -n 3 | tr '\n' ' ' | sed 's/ *$//')
  [ -z "${words}" ] || printf ' It said: %s.' "${words}"
}

case "${status}" in
  0)
    say "OK: a container shaped like a workspace (${repository}@${used_image}) resolved ${coder_host}, fetched the agent from ${coder_url}/bin/coder-linux-amd64 and reached ${repo_url} (attempt ${attempt} of ${attempts})"
    ;;
  11)
    fail "a workspace cannot resolve ${coder_host}, so none can download its agent and every lab waits at \"Agent is taking longer than expected to connect\". The sandbox daemon must give workspaces slirp4netns's forwarder (dns in /var/lib/hcw-coder-docker/.config/docker/daemon.json, the coder_sandbox role), and /etc/resolv.conf must name only the stub 127.0.0.53 (the host_firewall role). In sudo iptables -L HCW-SANDBOX-OUT -v -n, lookups that reach the stub count on 'hcw: the host resolver'; a rising 'hcw: refused' means they go elsewhere.$(said)"
    ;;
  12)
    fail "a workspace resolved ${coder_host} but could not fetch ${coder_url}/bin/coder-linux-amd64, so none can start its agent. Look at Caddy (systemctl status caddy), Coder (sudo docker logs --tail 50 coder) and the firewall's 'hcw: https to this host' rule (sudo iptables -L HCW-SANDBOX-OUT -v -n).$(said)"
    ;;
  13)
    fail "a workspace reached Coder but not ${repo_url}, so lab folders start empty. Look at the firewall's 'hcw: web egress' rule (sudo iptables -L HCW-SANDBOX-OUT -v -n) and whether the repository is public.$(said)"
    ;;
  20)
    fail "the sandbox daemon does not answer on ${docker_host}, so no workspace can start. Read sudo journalctl _UID=\$(id -u hcw-coder-docker) -n 80 --no-pager.$(said)"
    ;;
  21)
    fail "no ${repository} image is on the sandbox daemon, so every workspace would pull one before it starts. The lab_images role pulls the pinned one: sudo /opt/hcw-src/lab-host/bootstrap.sh --tags lab_images"
    ;;
  *)
    fail "the check's container did not run (exit ${status}).$(said)"
    ;;
esac
