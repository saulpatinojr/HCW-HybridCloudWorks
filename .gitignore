node_modules/
dist/
.env
*.pem
*.p12
*.pfx
*.key
**/serviceAccountKey.json
**/firebase-sa.json
**/kubeconfig
**/kubeconfig.*
.funcignore
local.settings.json
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json
.terraform/
# .terraform.lock.hcl is deliberately NOT ignored. The azurerm pin is `~> 4.0`,
# so without a committed lock CI resolves a different provider version than a
# developer does, and a provider minor release changes the plan under you.
*.enc.yaml
keys.txt

# Local exports and reports are never part of the website source tree.
export/
reports/
**/firebase-service-account.json

# Bootstrap run reports — hold real subscription and client ids.
# REVIEW.md keeps real values out of tracked files; this is not an exception.
scripts/.reports/

# Agentic orchestration run state - per-run local workflow JSON, handoffs, and
# the append-only session audit log. Regenerated by tooling/workflow.py; never
# a repository contract and it records local machine paths.
.agentic/

# MkDocs build output (docs-pages.yml uploads it as the Pages artifact).
site/

# Python bytecode. scripts/docs/hooks.py is an mkdocs hook, so every
# `mkdocs build` rewrites scripts/docs/__pycache__/; two of those files were
# tracked and every docs session had to check them out before committing.
__pycache__/
*.pyc

# Agent worktrees: isolated checkouts created by Claude Code for parallel work.
# They are real git worktrees, so staging one embeds a repository inside this one.
.claude/worktrees/

# Qlty CLI working state (#568). Only .qlty/qlty.toml, .qlty/.gitignore and
# .qlty/configs/ are tracked; .qlty/.gitignore (written by `qlty init`) already
# ignores the rest, and these are listed here too so a root-level reader sees
# them. Run output, logs, results, plugin sources and the tool cache are local.
.qlty/out/
.qlty/logs/
.qlty/results/
.qlty/sources/
.qlty/cache/
.qlty/plugin_cachedir/

# Vitest coverage output (`npm run test:coverage`, #568). frontend/.gitignore
# already covers frontend/coverage; this covers functions/ and any package.
coverage/

# Per-developer MCP servers for VS Code. .vscode/settings.json and the other
# workspace files are shared; this one names local tools and local paths.
.vscode/mcp.json

# ansible-galaxy writes collections it installs for a local run under .ansible/ next to the playbook; never source.
.ansible/

# External review materials and assessment documents
/doc/analysis/
/docs/analysis/

# Built desktop-plugin distribution includes runtime dependencies.
obsidian-plugin/dist/
.brain-*.log

