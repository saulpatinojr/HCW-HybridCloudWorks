{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "description": "Shared contract fixture between the Azure Functions agent API and vps-agent client (QA-3 #978). Renaming or altering fields on either side fails cross-boundary contract tests.",
  "rpcs": {
    "claimLabJob": {
      "path": "agent/claimLabJob",
      "method": "POST",
      "request": {
        "requiredFields": ["agentId"],
        "optionalFields": [],
        "sample": {
          "agentId": "vps-hostinger-01"
        }
      },
      "response": {
        "success": {
          "requiredFields": ["ok", "job"],
          "sampleNoJob": {
            "ok": true,
            "job": null
          },
          "sampleWithJob": {
            "ok": true,
            "job": {
              "id": "job-101",
              "claimId": "claim-202",
              "type": "shell-echo",
              "payload": "echo test",
              "payloadEncoding": "text"
            }
          },
          "jobFields": {
            "requiredFields": ["id", "claimId", "type", "payload", "payloadEncoding"]
          }
        }
      }
    },
    "heartbeat": {
      "path": "agent/heartbeat",
      "method": "POST",
      "request": {
        "requiredFields": ["agentId", "status", "activeJobs", "hostname", "version"],
        "optionalFields": ["applied", "certificateExpiresAt"],
        "validStatuses": ["idle", "busy", "stopping", "offline"],
        "sampleMinimal": {
          "agentId": "vps-hostinger-01",
          "status": "idle",
          "activeJobs": 0,
          "hostname": "srv17923.hstgr.cloud",
          "version": "2.0.0"
        },
        "sampleFull": {
          "agentId": "vps-hostinger-01",
          "status": "idle",
          "activeJobs": 0,
          "hostname": "srv17923.hstgr.cloud",
          "version": "2.0.0",
          "applied": {
            "commit": "0123456789abcdef0123456789abcdef01234567",
            "committedAt": "2026-10-09T23:02:14-05:00",
            "appliedAt": "2026-10-10T04:31:07Z"
          },
          "certificateExpiresAt": "2027-04-14T00:00:00.000Z"
        },
        "appliedFields": {
          "requiredFields": ["commit", "committedAt", "appliedAt"]
        }
      },
      "response": {
        "success": {
          "requiredFields": ["ok"],
          "sample": {
            "ok": true
          }
        }
      }
    },
    "completeLabJob": {
      "path": "agent/completeLabJob",
      "method": "POST",
      "request": {
        "requiredFields": ["agentId", "jobId", "status", "exitCode", "output"],
        "optionalFields": ["claimId"],
        "validStatuses": ["succeeded", "failed", "timeout"],
        "sample": {
          "agentId": "vps-hostinger-01",
          "jobId": "job-101",
          "claimId": "claim-202",
          "status": "succeeded",
          "exitCode": 0,
          "output": "ok"
        }
      },
      "response": {
        "success": {
          "requiredFields": ["ok"],
          "sample": {
            "ok": true
          }
        }
      }
    },
    "reportCoderAutomation": {
      "path": "agent/reportCoderAutomation",
      "method": "POST",
      "request": {
        "requiredFields": ["agentId", "report"],
        "optionalFields": ["statusToken"],
        "sample": {
          "agentId": "vps-hostinger-01",
          "statusToken": "FAKEKEYID0-FAKESECRETFAKESECRET00",
          "report": {
            "checkedAt": "2026-10-08T04:30:00Z"
          }
        },
        "reportFields": {
          "requiredFields": ["checkedAt"],
          "optionalFields": [
            "statusTokenExpiresAt",
            "statusTokenRotatedAt",
            "rotationTokenExpiresAt",
            "templatePushedAt",
            "templateVersion",
            "templateDigest",
            "templateSourceDigest",
            "lastError"
          ]
        }
      },
      "response": {
        "success": {
          "requiredFields": ["ok", "stored"],
          "sample": {
            "ok": true,
            "stored": true
          }
        }
      }
    }
  }
}
